# Copy to .env (git-ignored) for local development, and add the same variables in Vercel.

# Neon → your project → Connect → choose the "rentigo" database → copy the connection string
DATABASE_URL=postgresql://user:password@host/rentigo?sslmode=require

# Password for the admin panel (/login?admin=1). Locally a random one is generated in data/ if this is empty.
ADMIN_PASSWORD=
