# SMTP configuration example
# Copy this file to .env and fill with your SMTP provider credentials

# Use SendGrid example (recommended for production):
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=YOUR_SENDGRID_API_KEY
SMTP_SECURE=false

# Or Gmail (use App Password if 2FA enabled):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.email@gmail.com
# SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
# SMTP_SECURE=false

# Optional: set NODE_ENV=production in production environments
# NODE_ENV=production
